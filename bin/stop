#!/usr/bin/env python3
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from policy.stop import append

if len(sys.argv) != 2:
    raise SystemExit("usage: bin/stop <run_id>")
append(ROOT, sys.argv[1], "requested")
print(f"stop requested for {sys.argv[1]}")
